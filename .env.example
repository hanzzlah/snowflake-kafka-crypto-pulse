# ==============================================================================
# Crypto Pulse Tracker - Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your credentials.
# DO NOT commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# External API Keys
# ------------------------------------------------------------------------------
# API key from NewsAPI (https://newsapi.org) used for headline sentiment scoring
NEWS_API_KEY=your_news_api_key_here

# ------------------------------------------------------------------------------
# Snowflake Authentication
# ------------------------------------------------------------------------------
# Snowflake Account Identifier (format: <orgname>-<accountname> or <account_locator>.<region>)
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier

# Snowflake Username with permissions to access target DB and Warehouse
SNOWFLAKE_USER=your_snowflake_username

# Path to the local RSA private key file (.p8 / .pem) used for key-pair authentication
SNOWFLAKE_PRIVATE_KEY_PATH=path/to/rsa_key.p8

# Passphrase used when generating the encrypted RSA private key (leave empty if key is unencrypted)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ------------------------------------------------------------------------------
# Snowflake Database & Compute Infrastructure
# ------------------------------------------------------------------------------
# Target Database for the Lambda architecture tables
SNOWFLAKE_DATABASE=CRYPTO_PULSE_DB

# Target Schema within the database
SNOWFLAKE_SCHEMA=PUBLIC

# Virtual Warehouse used for running Snowpark queries, tasks, and transformations
SNOWFLAKE_WAREHOUSE=CRYPTO_PULSE_WH

# Snowflake Role executing DDL scripts, Snowpipe streaming, and tasks
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ------------------------------------------------------------------------------
# Apache Kafka Settings (Speed Layer)
# ------------------------------------------------------------------------------
# Kafka Broker connection string (comma-separated list for cluster setups)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Target Kafka Topic name for live price tick events
KAFKA_TOPIC=price_ticks